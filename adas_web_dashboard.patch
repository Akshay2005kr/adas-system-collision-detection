+        'animals': 0,
+        'potholes': 0,
+        'humps': 0,
+        'risk': 'LOW',
+        'distance': 'N/A',
+        'speed': 'N/A',
+        'ttc': 'N/A',
+        'brake_pct': 0,
+        'direction': 'STRAIGHT'
