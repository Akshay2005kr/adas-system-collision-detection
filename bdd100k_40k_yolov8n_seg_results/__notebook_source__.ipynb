import os
import shutil
from tqdm import tqdm

SOURCE = "/kaggle/input/datasets/akshayadgtrrtgfg/bdd100k-yolo-segmentation/bdd100k_yolo_seg"
DEST = "/kaggle/working/bdd100k_40k"

# Create folders
for folder in [
    "images/train",
    "images/val",
    "labels/train",
    "labels/val"
]:
    os.makedirs(os.path.join(DEST, folder), exist_ok=True)

def copy_pairs(src_img, src_lbl, dst_img, dst_lbl, limit):
    images = [
        f for f in os.listdir(src_img)
        if f.lower().endswith((".jpg", ".jpeg", ".png"))
    ]

    images.sort()
    copied = 0

    for img_name in tqdm(images[:limit], total=min(limit, len(images))):
        label_name = os.path.splitext(img_name)[0] + ".txt"

        img_path = os.path.join(src_img, img_name)
        label_path = os.path.join(src_lbl, label_name)

        # Only copy images that have labels
        if os.path.exists(label_path):
            shutil.copy2(
                img_path,
                os.path.join(dst_img, img_name)
            )
            shutil.copy2(
                label_path,
                os.path.join(dst_lbl, label_name)
            )
            copied += 1

    return copied


# 40,000 training images
train_count = copy_pairs(
    os.path.join(SOURCE, "images/train"),
    os.path.join(SOURCE, "labels/train"),
    os.path.join(DEST, "images/train"),
    os.path.join(DEST, "labels/train"),
    40000
)

# 5,000 validation images
val_count = copy_pairs(
    os.path.join(SOURCE, "images/val"),
    os.path.join(SOURCE, "labels/val"),
    os.path.join(DEST, "images/val"),
    os.path.join(DEST, "labels/val"),
    5000
)

print("\n==============================")
print("DATASET READY")
print("==============================")
print("Training:", train_count)
print("Validation:", val_count)
print("Location:", DEST)


